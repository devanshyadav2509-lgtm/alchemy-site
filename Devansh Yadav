  <!-- JAVASCRIPT LOGIC -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Page Switcher Function
    function switchPage(pageId) {
      const pages = ['overview', 'domains', 'chemeleon', 'quiz', 'leadership'];
      
      pages.forEach(p => {
        const pageSection = document.getElementById('page-' + p);
        const navBtn = document.getElementById('nav-' + p);
        
        if (p === pageId) {
          pageSection.classList.remove('hidden');
          if (navBtn) {
            navBtn.classList.add('text-teal-300', 'bg-[#172338]');
            navBtn.classList.remove('text-slate-400');
          }
        } else {
          pageSection.classList.add('hidden');
          if (navBtn) {
            navBtn.classList.remove('text-teal-300', 'bg-[#172338]');
            navBtn.classList.add('text-slate-400');
          }
        }
      });
      
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Particle Background
    const bgCanvas = document.getElementById('bgCanvas');
    const bgCtx = bgCanvas.getContext('2d');
    let particles = [];

    function resizeBgCanvas() {
      bgCanvas.width = window.innerWidth;
      bgCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeBgCanvas);
    resizeBgCanvas();

    for (let i = 0; i < 45; i++) {
      particles.push({
        x: Math.random() * bgCanvas.width,
        y: Math.random() * bgCanvas.height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2 + 1
      });
    }

    function animateBg() {
      bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
      bgCtx.fillStyle = '#38BDF8';
      bgCtx.strokeStyle = 'rgba(56, 189, 248, 0.08)';

      particles.forEach((p, i) => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > bgCanvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > bgCanvas.height) p.vy *= -1;

        bgCtx.beginPath();
        bgCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        bgCtx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
          if (dist < 140) {
            bgCtx.beginPath();
            bgCtx.moveTo(p.x, p.y);
            bgCtx.lineTo(p2.x, p2.y);
            bgCtx.stroke();
          }
        }
      });
      requestAnimationFrame(animateBg);
    }
    animateBg();

    // 3D Interactive Molecule Viewer
    const molCanvas = document.getElementById('moleculeCanvas');
    const molCtx = molCanvas.getContext('2d');

    let isDragging = false;
    let prevMousePos = { x: 0, y: 0 };
    let rotX = 0.4, rotY = 0.4;

    function resizeMolCanvas() {
      if (molCanvas.parentElement) {
        molCanvas.width = molCanvas.parentElement.clientWidth;
        molCanvas.height = molCanvas.parentElement.clientHeight;
      }
    }
    window.addEventListener('resize', resizeMolCanvas);
    resizeMolCanvas();

    const molecules = {
      nanotube: generateNanotube(),
      caffeine: generateRing(),
      buckyball: generateBucky()
    };

    let currentMolecule = molecules.nanotube;

    function generateNanotube() {
      let nodes = [], bonds = [];
      for (let ring = -3; ring <= 3; ring++) {
        for (let i = 0; i < 8; i++) {
          let angle = (i / 8) * Math.PI * 2;
          nodes.push({ x: Math.cos(angle) * 60, y: ring * 30, z: Math.sin(angle) * 60 });
        }
      }
      for (let r = 0; r < 7; r++) {
        for (let i = 0; i < 8; i++) {
          let idx = r * 8 + i;
          let nextI = r * 8 + ((i + 1) % 8);
          bonds.push([idx, nextI]);
          if (r < 6) bonds.push([idx, idx + 8]);
        }
      }
      return { nodes, bonds, name: "Carbon Nanotube Lattice (C60 Derivative)" };
    }

    function generateRing() {
      let nodes = [], bonds = [];
      for (let i = 0; i < 6; i++) {
        let angle = (i / 6) * Math.PI * 2;
        nodes.push({ x: Math.cos(angle) * 70, y: Math.sin(angle) * 70, z: 0 });
      }
      for (let i = 0; i < 6; i++) {
        bonds.push([i, (i + 1) % 6]);
      }
      return { nodes, bonds, name: "Aromatic Benzene Hybridization Ring" };
    }

    function generateBucky() {
      let nodes = [
        {x: 0, y: -70, z: 0}, {x: 50, y: -35, z: 30}, {x: -50, y: -35, z: 30},
        {x: 0, y: 35, z: 60}, {x: 50, y: 35, z: -30}, {x: -50, y: 35, z: -30}, {x: 0, y: 70, z: 0}
      ];
      let bonds = [[0,1], [0,2], [1,3], [2,3], [1,4], [2,5], [3,6], [4,6], [5,6]];
      return { nodes, bonds, name: "Quantum Dot Nanoparticle Node" };
    }

    function changeMolecule(type) {
      currentMolecule = molecules[type];
      document.getElementById('molName').innerText = currentMolecule.name;
    }

    molCanvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevMousePos = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('mouseup', () => isDragging = false);

    molCanvas.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      let dx = e.clientX - prevMousePos.x;
      let dy = e.clientY - prevMousePos.y;
      rotY += dx * 0.01;
      rotX += dy * 0.01;
      prevMousePos = { x: e.clientX, y: e.clientY };
    });

    function renderMolecule() {
      molCtx.clearRect(0, 0, molCanvas.width, molCanvas.height);
      const cx = molCanvas.width / 2;
      const cy = molCanvas.height / 2;

      let projected = currentMolecule.nodes.map(n => {
        let x = n.x, y = n.y, z = n.z;
        let y1 = y * Math.cos(rotX) - z * Math.sin(rotX);
        let z1 = y * Math.sin(rotX) + z * Math.cos(rotX);
        let x2 = x * Math.cos(rotY) + z1 * Math.sin(rotY);
        let z2 = -x * Math.sin(rotY) + z1 * Math.cos(rotY);

        return { px: cx + x2, py: cy + y1, z: z2 };
      });

      molCtx.strokeStyle = 'rgba(45, 212, 191, 0.4)';
      molCtx.lineWidth = 2;
      currentMolecule.bonds.forEach(([i, j]) => {
        molCtx.beginPath();
        molCtx.moveTo(projected[i].px, projected[i].py);
        molCtx.lineTo(projected[j].px, projected[j].py);
        molCtx.stroke();
      });

      projected.forEach(p => {
        let radius = 6 + (p.z / 30);
        molCtx.beginPath();
        molCtx.arc(p.px, p.py, Math.max(2, radius), 0, Math.PI * 2);
        molCtx.fillStyle = '#38BDF8';
        molCtx.shadowColor = '#38BDF8';
        molCtx.shadowBlur = 10;
        molCtx.fill();
        molCtx.shadowBlur = 0;
      });

      if (!isDragging) rotY += 0.005;
      requestAnimationFrame(renderMolecule);
    }
    renderMolecule();

    // Interactive Quiz Mechanics
    let totalScore = 0;
    let answered = {};

    function answerQuiz(qNum, isCorrect, btn) {
      if (answered[qNum]) return;
      answered[qNum] = true;

      const parent = btn.parentElement;
      const buttons = parent.querySelectorAll('.q-btn');
      buttons.forEach(b => b.classList.add('opacity-50', 'pointer-events-none'));

      if (isCorrect) {
        btn.classList.remove('bg-slate-900', 'border-slate-800');
        btn.classList.add('bg-teal-500/20', 'border-teal-400', 'text-teal-300');
        totalScore += qNum;
      } else {
        btn.classList.remove('bg-slate-900', 'border-slate-800');
        btn.classList.add('bg-pink-500/20', 'border-pink-400', 'text-pink-300');
      }

      document.getElementById('scoreDisplay').innerText = `Score: ${totalScore} pts`;
    }
  </script>

