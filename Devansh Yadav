<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ALCHEMY | High School Chemistry & Research Incubator</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts & Lucide Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              dark: '#030712',
              card: '#0B0F19',
              border: '#1E293B',
              cyan: '#38BDF8',
              teal: '#2DD4BF',
              emerald: '#34D399',
              magenta: '#EC4899',
              purple: '#A855F7',
            }
          }
        }
      }
    }
  </script>

  <style>
    body { background-color: #030712; color: #F8FAFC; overflow-x: hidden; }
    .glass-panel {
      background: rgba(11, 15, 25, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card:hover {
      border-color: rgba(56, 189, 248, 0.4);
      transform: translateY(-3px);
      box-shadow: 0 12px 30px -10px rgba(56, 189, 248, 0.15);
    }
    .text-gradient {
      background: linear-gradient(135deg, #38BDF8 0%, #2DD4BF 50%, #34D399 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .text-spectrum {
      background: linear-gradient(135deg, #A855F7 0%, #EC4899 33%, #38BDF8 66%, #34D399 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>
<body class="selection:bg-teal-400 selection:text-slate-950">

  <!-- Particle Mesh Canvas Background -->
  <canvas id="bgCanvas" class="fixed top-0 left-0 w-full h-full pointer-events-none z-0 opacity-40"></canvas>

  <!-- Global Header Navigation Bar (Matches Design) -->
  <header class="fixed top-0 left-0 w-full z-50 bg-[#030712]/90 backdrop-blur-md border-b border-slate-800/80 py-4 px-6">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo & Title -->
      <div class="flex items-center space-x-3 cursor-pointer" onclick="switchPage('overview')">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-sky-400 via-teal-400 to-emerald-400 p-[2px] shadow-lg shadow-teal-500/20">
          <div class="w-full h-full bg-[#030712] rounded-[14px] flex items-center justify-center font-extrabold text-white text-xl">
            A
          </div>
        </div>
        <div>
          <div class="font-extrabold tracking-wider text-xl text-white leading-none">ALCHEMY</div>
          <div class="text-[9px] font-mono font-bold tracking-widest text-teal-400 uppercase mt-1">RESEARCH INCUBATOR</div>
        </div>
      </div>

      <!-- Navigation Bar Pill Tabs -->
      <nav class="hidden md:flex items-center bg-[#0b1120] p-1.5 rounded-2xl border border-slate-800/80 text-xs font-semibold">
        <button id="nav-overview" onclick="switchPage('overview')" class="px-5 py-2 rounded-xl transition-all font-medium text-teal-300 bg-[#172338]">Overview</button>
        <button id="nav-domains" onclick="switchPage('domains')" class="px-5 py-2 rounded-xl transition-all font-medium text-slate-400 hover:text-white">Focus Domains</button>
        <button id="nav-chemeleon" onclick="switchPage('chemeleon')" class="px-5 py-2 rounded-xl transition-all font-medium text-slate-400 hover:text-white">CHEMELEON</button>
        <button id="nav-quiz" onclick="switchPage('quiz')" class="px-5 py-2 rounded-xl transition-all font-medium text-slate-400 hover:text-white">Weekly Quiz</button>
        <button id="nav-leadership" onclick="switchPage('leadership')" class="px-5 py-2 rounded-xl transition-all font-medium text-slate-400 hover:text-white">Leadership</button>
      </nav>

      <!-- Take Weekly Quiz CTA Button -->
      <button onclick="switchPage('quiz')" class="bg-gradient-to-r from-sky-400 via-teal-400 to-emerald-400 text-slate-950 font-bold px-6 py-2.5 rounded-2xl text-xs hover:shadow-lg hover:shadow-teal-500/30 transition-all flex items-center space-x-2">
        <i data-lucide="zap" class="w-4 h-4 fill-slate-950"></i>
        <span>Take Weekly Quiz</span>
      </button>

    </div>
  </header>

  <!-- MULTI-PAGE CONTAINER CONTENT -->
  <main class="relative z-10 pt-28 pb-20 px-4 sm:px-6 max-w-7xl mx-auto">

    <!-- PAGE 1: OVERVIEW -->
    <section id="page-overview" class="page-view space-y-16">
      
      <!-- Hero Unit -->
      <div class="text-center space-y-6 pt-8">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-mono tracking-widest uppercase">
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
          <span>Where Curiosity Transforms Matter</span>
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold text-white tracking-tight leading-tight max-w-4xl mx-auto">
          High School Chemistry Meets <br>
          <span class="text-gradient">Advanced Scientific Research</span>
        </h1>

        <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          ALCHEMY bridges foundational chemistry with 3D computational modeling, nanotechnology, green energy solutions, and quantum physical concepts.
        </p>

        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <button onclick="switchPage('domains')" class="bg-teal-400 text-slate-950 font-bold px-7 py-3.5 rounded-xl hover:bg-teal-300 transition-all text-sm flex items-center space-x-2 shadow-lg shadow-teal-500/20">
            <span>Explore Focus Areas</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
          <button onclick="switchPage('chemeleon')" class="glass-card text-white font-semibold px-7 py-3.5 rounded-xl hover:bg-slate-800/80 transition-all text-sm border border-slate-700/60">
            Read CHEMELEON Newsletter
          </button>
        </div>
      </div>

      <!-- Interactive 3D Molecule Viewer -->
      <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-slate-800 relative overflow-hidden space-y-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <div class="flex items-center space-x-2 text-sky-400 text-xs font-mono font-bold uppercase">
              <i data-lucide="box" class="w-4 h-4"></i>
              <span>Interactive Molecular Viewer</span>
            </div>
            <h3 class="text-xl font-bold text-white mt-1">3D Computational Molecular Sandbox</h3>
            <p class="text-xs text-slate-400">Click and drag inside the viewport to rotate structures in 3D space.</p>
          </div>

          <!-- Controls -->
          <div class="flex space-x-2">
            <button onclick="changeMolecule('nanotube')" class="px-3.5 py-2 rounded-xl bg-sky-500/20 border border-sky-500/40 text-sky-300 text-xs font-mono hover:bg-sky-500/30 transition">Nanotube</button>
            <button onclick="changeMolecule('caffeine')" class="px-3.5 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-mono hover:border-sky-400 transition">Aromatic Ring</button>
            <button onclick="changeMolecule('buckyball')" class="px-3.5 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-mono hover:border-sky-400 transition">Quantum Node</button>
          </div>
        </div>

        <!-- Canvas -->
        <div class="relative w-full h-[340px] bg-slate-950/90 rounded-2xl border border-slate-800 overflow-hidden cursor-grab active:cursor-grabbing">
          <canvas id="moleculeCanvas" class="w-full h-full"></canvas>
          <div class="absolute bottom-4 left-4 bg-slate-900/90 backdrop-blur px-3.5 py-2 rounded-xl border border-slate-800 text-[11px] font-mono text-slate-300 flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span id="molName">Carbon Nanotube Lattice (C60 Derivative)</span>
          </div>
        </div>
      </div>

      <!-- Core Pillars -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-white text-center">Four-Fold Club Architecture</h2>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="glass-card p-6 rounded-2xl space-y-3">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center font-bold">
              <i data-lucide="microscope" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-lg text-white">The ALCHEMY Club</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Hands-on 3D molecular modeling, research discussions, and practical workshops.</p>
          </div>

          <div class="glass-card p-6 rounded-2xl space-y-3">
            <div class="w-10 h-10 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center font-bold">
              <i data-lucide="book-open" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-lg text-white">CHEMELEON</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Monthly student publication highlighting scientific research, computational renders, and artwork.</p>
          </div>

          <div class="glass-card p-6 rounded-2xl space-y-3">
            <div class="w-10 h-10 rounded-xl bg-teal-500/10 text-teal-400 flex items-center justify-center font-bold">
              <i data-lucide="trophy" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-lg text-white">Reaction Rate Quiz</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Weekly school-wide gamified questionnaire fostering continuous curiosity and point scoring.</p>
          </div>

          <div class="glass-card p-6 rounded-2xl space-y-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold">
              <i data-lucide="award" class="w-5 h-5"></i>
            </div>
            <h3 class="font-bold text-lg text-white">ChemHistory Olympiad</h3>
            <p class="text-xs text-slate-400 leading-relaxed">Annual competition dedicated to chemistry history, discoveries, and pioneering scientists.</p>
          </div>
        </div>
      </div>

    </section>

    <!-- PAGE 2: FOCUS DOMAINS -->
    <section id="page-domains" class="page-view hidden space-y-10">
      
      <div class="text-center space-y-3">
        <span class="text-xs font-mono font-bold text-teal-400 uppercase tracking-widest">Pedagogical Structure</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white">Four Core Research Domains</h2>
        <p class="text-slate-400 text-sm max-w-xl mx-auto">Moving beyond qualitative textbook reactions into quantitative modern science.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Domain 1 -->
        <div class="glass-card p-8 rounded-3xl space-y-4 border border-slate-800">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono text-sky-400 font-bold uppercase">Domain 01</span>
            <span class="px-2.5 py-1 rounded-md bg-sky-500/10 text-sky-300 text-[11px] font-mono">Software Modeling</span>
          </div>
          <h3 class="text-2xl font-bold text-white">Computational Chemistry</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            3D molecular geometry, potential energy surfaces, ligand-protein docking, and electrostatic potential mapping.
          </p>
          <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs space-y-1">
            <span class="font-bold text-sky-300">Practical Activity:</span>
            <p class="text-slate-400">Hands-on modeling workshops using open-source tools (Avogadro, PyMOL) to visualize biomolecules.</p>
          </div>
        </div>

        <!-- Domain 2 -->
        <div class="glass-card p-8 rounded-3xl space-y-4 border border-slate-800">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono text-teal-400 font-bold uppercase">Domain 02</span>
            <span class="px-2.5 py-1 rounded-md bg-teal-500/10 text-teal-300 text-[11px] font-mono">Advanced Materials</span>
          </div>
          <h3 class="text-2xl font-bold text-white">Nanotechnology</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Quantum confinement, quantum dots, surface-area-to-volume ratio scaling, carbon nanotube lattices, and surface plasmon resonance.
          </p>
          <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs space-y-1">
            <span class="font-bold text-teal-300">Practical Activity:</span>
            <p class="text-slate-400">Case studies on targeted drug delivery systems and silver nanoparticles for antimicrobial water filtration.</p>
          </div>
        </div>

        <!-- Domain 3 -->
        <div class="glass-card p-8 rounded-3xl space-y-4 border border-slate-800">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono text-emerald-400 font-bold uppercase">Domain 03</span>
            <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-300 text-[11px] font-mono">Clean Energy</span>
          </div>
          <h3 class="text-2xl font-bold text-white">Green Energy Systems</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Proton exchange membrane (PEM) fuel cells, water electrolysis, solid-state battery electrolytes, and carbon capture sorbents.
          </p>
          <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs space-y-1">
            <span class="font-bold text-emerald-300">Practical Activity:</span>
            <p class="text-slate-400">Designing proposals for hydrogen transit systems and evaluating metal-organic frameworks for carbon capture.</p>
          </div>
        </div>

        <!-- Domain 4 -->
        <div class="glass-card p-8 rounded-3xl space-y-4 border border-slate-800">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono text-purple-400 font-bold uppercase">Domain 04</span>
            <span class="px-2.5 py-1 rounded-md bg-purple-500/10 text-purple-300 text-[11px] font-mono">Physical Concepts</span>
          </div>
          <h3 class="text-2xl font-bold text-white">Quantum Foundations & Spectroscopy</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Orbital hybridization, spectroscopy decoding (IR, NMR, UV-Vis), molecular symmetry, and thermodynamics.
          </p>
          <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs space-y-1">
            <span class="font-bold text-purple-300">Practical Activity:</span>
            <p class="text-slate-400">Spectral fingerprint decoding challenges and investigating reaction mechanisms at atomic timescales.</p>
          </div>
        </div>
      </div>

    </section>

    <!-- PAGE 3: CHEMELEON -->
    <section id="page-chemeleon" class="page-view hidden space-y-10">
      
      <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-slate-800 relative overflow-hidden">
        <div class="max-w-3xl space-y-4">
          <span class="px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/30 text-pink-400 text-xs font-mono font-bold uppercase">Monthly Publication</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-spectrum">CHEMELEON</h2>
          <p class="text-lg font-semibold text-white">"Show Your True Colours"</p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Celebrating adaptability, vibrant curiosity, and the spectrum of student talents across scientific writing, graphic illustration, coding, and history.
          </p>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-bold text-white">Monthly Columns & Submissions Blueprint</h3>
        
        <div class="grid gap-4">
          <div class="glass-card p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="space-y-1">
              <span class="text-xs font-mono text-sky-400 font-bold">THE CATALYST (Lead Article)</span>
              <h4 class="font-bold text-white text-base">Major Modern Breakthroughs</h4>
              <p class="text-xs text-slate-400">Deep dives into room-temperature superconductors, CRISPR scissors, and green hydrogen mobility.</p>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 text-xs font-mono border border-slate-700 whitespace-nowrap">Senior Writers & Research Leads</span>
          </div>

          <div class="glass-card p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="space-y-1">
              <span class="text-xs font-mono text-teal-400 font-bold">MOLECULES IN MOTION</span>
              <h4 class="font-bold text-white text-base">Computational Renders & Modeling</h4>
              <p class="text-xs text-slate-400">3D renderings and downloadable molecular structures created by students in modeling workshops.</p>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 text-xs font-mono border border-slate-700 whitespace-nowrap">Computational Modeling Team</span>
          </div>

          <div class="glass-card p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="space-y-1">
              <span class="text-xs font-mono text-emerald-400 font-bold">EVERYDAY REACTIONS</span>
              <h4 class="font-bold text-white text-base">Accessible Chemistry Phenomena</h4>
              <p class="text-xs text-slate-400">Maillard reactions in cooking, coffee extraction kinetics, and sunscreen UV filters.</p>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 text-xs font-mono border border-slate-700 whitespace-nowrap">Junior Writers & Middle Schoolers</span>
          </div>

          <div class="glass-card p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="space-y-1">
              <span class="text-xs font-mono text-pink-400 font-bold">SPECTRUM & SKETCHES</span>
              <h4 class="font-bold text-white text-base">Scientific Artwork & Graphics</h4>
              <p class="text-xs text-slate-400">Original scientific artwork, molecular infographics, chemistry memes, and visual summaries.</p>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 text-xs font-mono border border-slate-700 whitespace-nowrap">Student Artists & Designers</span>
          </div>

          <div class="glass-card p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="space-y-1">
              <span class="text-xs font-mono text-amber-400 font-bold">HISTORICAL ALCHEMISTS</span>
              <h4 class="font-bold text-white text-base">Pioneers & Unexpected Discoveries</h4>
              <p class="text-xs text-slate-400">Stories of pioneering scientists, marginalized researchers in STEM history, and unexpected discoveries.</p>
            </div>
            <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 text-xs font-mono border border-slate-700 whitespace-nowrap">History Enthusiasts</span>
          </div>
        </div>
      </div>

    </section>

    <!-- PAGE 4: WEEKLY QUIZ -->
    <section id="page-quiz" class="page-view hidden space-y-10">
      
      <div class="text-center space-y-3">
        <span class="text-xs font-mono font-bold text-teal-400 uppercase tracking-widest">Gamified Challenge</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white">The Reaction Rate Check</h2>
        <p class="text-slate-400 text-sm max-w-xl mx-auto">Released every Monday morning. Test your chemistry intuition, score points, and climb the school leaderboard!</p>
      </div>

      <!-- Point Matrix Grid -->
      <div class="grid sm:grid-cols-3 gap-4">
        <div class="glass-card p-5 rounded-2xl border-l-4 border-l-sky-400">
          <span class="text-xs font-mono text-sky-400 font-bold">TIER 1 • BUILD UP</span>
          <div class="text-lg font-bold text-white mt-1">1 Point</div>
          <p class="text-xs text-slate-400 mt-1">Conceptual questions open to all grade levels.</p>
        </div>
        <div class="glass-card p-5 rounded-2xl border-l-4 border-l-teal-400">
          <span class="text-xs font-mono text-teal-400 font-bold">TIER 2 • THRILLING</span>
          <div class="text-lg font-bold text-white mt-1">2 Points</div>
          <p class="text-xs text-slate-400 mt-1">Application problems requiring analytical reasoning.</p>
        </div>
        <div class="glass-card p-5 rounded-2xl border-l-4 border-l-purple-400">
          <span class="text-xs font-mono text-purple-400 font-bold">TIER 3 • CHALLENGING</span>
          <div class="text-lg font-bold text-white mt-1">3 Points</div>
          <p class="text-xs text-slate-400 mt-1">Multi-step stoichiometry, quantum numbers, or industrial calculations.</p>
        </div>
      </div>

      <!-- Interactive Quiz Engine -->
      <div class="glass-panel p-6 sm:p-10 rounded-3xl border border-slate-800 space-y-6">
        <div class="flex justify-between items-center border-b border-slate-800 pb-4">
          <span class="font-mono text-xs text-teal-400 font-bold">INTERACTIVE SAMPLE QUIZ</span>
          <span id="scoreDisplay" class="font-mono text-xs bg-teal-500/20 text-teal-300 px-3 py-1 rounded-full border border-teal-500/30">Score: 0 pts</span>
        </div>

        <!-- Question 1 -->
        <div class="space-y-3">
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 text-[10px] font-mono font-bold">Q1 • 1pt</span>
            <h4 class="text-sm font-bold text-white">Why do sliced apples brown, and how does lemon juice prevent it?</h4>
          </div>
          <div class="grid sm:grid-cols-2 gap-2 text-xs">
            <button onclick="answerQuiz(1, true, this)" class="q-btn text-left p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:border-teal-400 transition">Enzymatic oxidation by polyphenol oxidase; citric acid lowers pH to denature the enzyme.</button>
            <button onclick="answerQuiz(1, false, this)" class="q-btn text-left p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:border-teal-400 transition">Dehydration of cellular walls; sugar in lemon juice coats the surface.</button>
          </div>
        </div>

        <!-- Question 2 -->
        <div class="space-y-3 pt-4 border-t border-slate-800/60">
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 rounded bg-teal-500/20 text-teal-300 text-[10px] font-mono font-bold">Q2 • 2pt</span>
            <h4 class="text-sm font-bold text-white">If a hydrogen fuel cell train reacts 100 kg of H₂ gas with atmospheric O₂, what mass of pure water vapor is produced?</h4>
          </div>
          <div class="grid sm:grid-cols-2 gap-2 text-xs">
            <button onclick="answerQuiz(2, false, this)" class="q-btn text-left p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:border-teal-400 transition">450 kg of H₂O vapor</button>
